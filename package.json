{
  "name": "mailboxed",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:backend": "bun --watch src/index.ts",
    "dev:frontend": "cd frontend && bun dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"bun dev:backend\" \"bun dev:frontend\"",
    "build:frontend": "cd frontend && bun run build",
    "build": "bun run build:frontend",
    "db:push": "bunx drizzle-kit push"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "croner": "^10.0.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "file-type": "^21.3.0",
    "imapflow": "^1.2.8",
    "pino": "^10.3.0",
    "zod": "^4.3.6"
  }
}
