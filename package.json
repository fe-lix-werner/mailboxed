{
	"name": "mailboxed",
	"version": "1.0.0",
	"description": "IMAP mailbox attachment downloader and manager",
	"module": "index.ts",
	"type": "module",
	"license": "MIT",
	"private": true,
	"workspaces": [
		"frontend"
	],
	"scripts": {
		"dev:backend": "bun --watch src/index.ts",
		"dev:frontend": "cd frontend && bun dev",
		"dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"bun dev:backend\" \"bun dev:frontend\"",
		"build:frontend": "cd frontend && bun run build",
		"build": "bun build --target=bun --production --outdir=dist ./src/index.ts && bun run build:frontend && mkdir -p dist/static && cp -r frontend/dist/* dist/static",
		"db:push": "bunx drizzle-kit push",
		"db:migrate": "bun src/db/index.ts --migrate",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"build-docker": "./build-docker.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@types/bun": "^1.3.8",
		"concurrently": "^9.2.1",
		"drizzle-kit": "^0.31.8",
		"pino-pretty": "^13.1.3"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@types/nodemailer": "^7.0.9",
		"croner": "^10.0.1",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.45.1",
		"file-type": "^21.3.0",
		"imapflow": "^1.2.8",
		"nodemailer": "^8.0.0",
		"pino": "^10.3.0",
		"zod": "^4.3.6"
	}
}
